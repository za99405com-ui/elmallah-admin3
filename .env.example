# Admin Authentication & Database Secret Keys
JWT_SECRET=your_secure_jwt_secret_key_here

# Supabase Auth & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Host port configuration (Default: 3000)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this app is hosted.
APP_URL=

# CORS: Comma-separated list of allowed origins (e.g. production domains)
ALLOWED_ORIGINS=https://almallah-fish.com,https://admin.almallah-fish.com

# Server-to-server customer store integration
CUSTOMER_APP_INTEGRATION_KEY=replace-with-a-long-random-secret
